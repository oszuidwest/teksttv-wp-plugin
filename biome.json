{
    "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
    "files": {
        "includes": [
            "resources/**/*.ts",
            "resources/**/*.js",
            "resources/**/*.css",
            "tests/**/*.ts",
            "tests/**/*.js",
            "playwright.config.ts"
        ]
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "complexity": {
                "noForEach": "off",
                "noImportantStyles": "off",
                "useOptionalChain": "off"
            },
            "correctness": {
                "noUnusedVariables": "warn"
            },
            "style": {
                "noDescendingSpecificity": "off",
                "useTemplate": "off"
            }
        }
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always"
        },
        "globals": ["tinymce", "wp", "teksttvPost", "TomSelect"]
    }
}
